# Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# API KEYS
# ===========================================

# Firecrawl API Key (https://www.firecrawl.dev/)
FIRECRAWL_API_KEY=fc-YOUR_API_KEY_HERE

# Hugging Face API Token (optional, for private models)
HUGGINGFACE_TOKEN=hf_YOUR_TOKEN_HERE

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Learning data storage path
LEARNING_DATA_PATH=./data/learning_data.json

# Export data path
EXPORT_DATA_PATH=./data/exports

# ===========================================
# SCRAPING CONFIGURATION
# ===========================================

# Use Selenium for scraping (true/false)
USE_SELENIUM=false

# Headless browser mode
HEADLESS=true

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# Rate limit delay between requests (seconds)
RATE_LIMIT_DELAY=2

# ===========================================
# NLP MODEL CONFIGURATION
# ===========================================

# Device for PyTorch (cpu/cuda)
TORCH_DEVICE=cpu

# Cache directory for HuggingFace models
HF_CACHE_DIR=./models/cache

# ===========================================
# APP CONFIGURATION
# ===========================================

# Streamlit server port
STREAMLIT_PORT=8501

# Debug mode
DEBUG=false

# Default city for salary lookup
DEFAULT_CITY=Makassar

# Default currency
DEFAULT_CURRENCY=IDR

# USD to IDR exchange rate
USD_TO_IDR=15800
